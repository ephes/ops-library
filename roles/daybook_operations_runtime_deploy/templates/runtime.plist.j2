<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>{{ daybook_operations_runtime_label | e }}</string>
<key>ProgramArguments</key><array>
<string>{{ daybook_operations_runtime_python | e }}</string><string>-I</string><string>-c</string>
<string>from daybook.cli import main; raise SystemExit(main())</string>
<string>operations</string><string>{{ daybook_operations_runtime_mode | e }}</string><string>--policy</string><string>{{ daybook_operations_runtime_policy | e }}</string>
</array>
<key>EnvironmentVariables</key><dict><key>HOME</key><string>{{ daybook_operations_runtime_home | e }}</string><key>PATH</key><string>/usr/bin:/bin</string></dict>
{% if daybook_operations_runtime_mode == 'serve' %}
{# The supervisor owns its own due times, so launchd must not also schedule it.
   KeepAlive is safe only because a binding that stopped for an operator records
   that stop beside its journal: the restarted supervisor reads the marker and
   dispatches nothing, instead of walking back into the state a person was meant
   to look at. Without that marker this key would be a retry loop. #}
<key>KeepAlive</key><true/>
{% else %}
<key>StartInterval</key><integer>300</integer>
{% endif %}
<key>RunAtLoad</key><true/>
<key>ProcessType</key><string>Background</string>
</dict></plist>

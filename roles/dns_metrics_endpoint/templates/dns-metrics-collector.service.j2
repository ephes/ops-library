[Unit]
Description=Collect authoritative DNS health metrics and write to JSON file
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c '/usr/bin/python3 {{ dns_metrics_endpoint_collector_path }} > {{ dns_metrics_endpoint_json_path }}.tmp && mv {{ dns_metrics_endpoint_json_path }}.tmp {{ dns_metrics_endpoint_json_path }}'

# Runs as root only to own/refresh the data directory and file modes; the DNS
# probes themselves need no privilege, so all capabilities except the ones the
# chown/chmod below use are dropped.
User=root
Group=root
NoNewPrivileges=true
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE

# Minimal hardening that keeps required root-level writes working.
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
PrivateTmp=true

# Bound the run so a hanging query can never wedge the timer.
TimeoutStartSec={{ dns_metrics_endpoint_timer_interval | int }}

# Ensure directory exists and has correct permissions
ExecStartPre=/bin/mkdir -p {{ dns_metrics_endpoint_data_dir }}
ExecStartPre=/bin/chown root:{{ dns_metrics_endpoint_group }} {{ dns_metrics_endpoint_data_dir }}
ExecStartPre=/bin/chmod 0750 {{ dns_metrics_endpoint_data_dir }}

# After writing, ensure the metrics user can read the file
ExecStartPost=/bin/chown root:{{ dns_metrics_endpoint_group }} {{ dns_metrics_endpoint_json_path }}
ExecStartPost=/bin/chmod 0640 {{ dns_metrics_endpoint_json_path }}

{{ '#' }} Managed by Ansible - Vaultwarden maintenance (ingress deny) switch.
{{ '#' }}
{{ '#' }} Deliberately a SEPARATE dynamic file from vaultwarden.yml. The Echoport
{{ '#' }} Vaultwarden backup archives that other file and its restore writes it back
{{ '#' }} without reloading Traefik, so a deny state stored there would be silently
{{ '#' }} reinstated by any restore taken from a backup made during a freeze.
{{ '#' }}
{{ '#' }} One router is enough: Vaultwarden serves live sync (/notifications/hub)
{{ '#' }} on its main Rocket port, so there is no second backend to route to.
{{ '#' }}
{{ '#' }} Removing this file ends the freeze; Traefik watches the directory.

http:
  routers:
    vaultwarden-maintenance:
      rule: "Host(`{{ vaultwarden_maintenance_hostname }}`)"
      priority: {{ vaultwarden_maintenance_router_priority }}
      entryPoints:
        - {{ vaultwarden_maintenance_traefik_entrypoint }}
      middlewares:
        - vaultwarden-maintenance-deny
      service: vaultwarden
      tls: {}

  middlewares:
    vaultwarden-maintenance-deny:
      ipAllowList:
        sourceRange:
{% for source_range in vaultwarden_maintenance_allow_source_ranges %}
          - "{{ source_range }}"
{% endfor %}

# Managed by Ansible - static_site_git_refresh {{ static_site_git_refresh_name }}
[Unit]
Description=Refresh static site {{ static_site_git_refresh_name }} from git
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User={{ static_site_git_refresh_user }}
Group={{ static_site_git_refresh_group }}
Environment=HOME={{ static_site_git_refresh_home }}
WorkingDirectory={{ static_site_git_refresh_home }}
ExecStart={{ static_site_git_refresh_script_path }}
TimeoutStartSec={{ (static_site_git_refresh_build_timeout_seconds | int) + 180 }}
Nice=10
UMask=0027
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths={{ static_site_git_refresh_home }} {{ static_site_git_refresh_publish_path }}
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

{# Keep the application format; quote only the management-command companion. #}
{% macro env_value(value) -%}{% if task_shell_environment | default(false) %}"{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') | replace('`', '\\`') }}"{% else %}{{ value }}{% endif %}{%- endmacro %}
# FastDeploy Environment Configuration
# Generated by fastdeploy-self service

# FastAPI/Security Settings
SECRET_KEY={{ env_value((secret_key)) }}
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (asyncpg for FastAPI)
DATABASE_URL={{ env_value('postgresql+asyncpg://' ~ (postgres_user | default('fastdeploy')) ~ ':' ~ (postgres_password) ~ '@' ~ (postgres_host) ~ ':' ~ (postgres_port | default('5432')) ~ '/' ~ (postgres_db_name)) }}

# Service Configuration
SERVICE_PORT={{ env_value((service_port | default(fd_self_service_port_blue))) }}

# Password hashing
PASSWORD_HASH_ALGORITHM={{ env_value((password_hash_algorithm | default('bcrypt'))) }}

# Paths
PATH_FOR_DEPLOY={{ env_value((fd_self_base_dir)) }}

{% if (fd_self_legacy_service_tokens_accepted_until | default('') | string | length > 0) or (fd_self_service_token_max_expire_days | default('') | string | length > 0) or (fd_self_service_token_retention_days | default('') | string | length > 0) %}
# Service tokens
{% endif %}
{% if fd_self_legacy_service_tokens_accepted_until | default('') | string | length > 0 %}
LEGACY_SERVICE_TOKENS_ACCEPTED_UNTIL={{ env_value((fd_self_legacy_service_tokens_accepted_until | string | replace(' ', 'T'))) }}
{% endif %}
{% if fd_self_service_token_max_expire_days | default('') | string | length > 0 %}
SERVICE_TOKEN_MAX_EXPIRE_DAYS={{ env_value((fd_self_service_token_max_expire_days)) }}
{% endif %}
{% if fd_self_service_token_retention_days | default('') | string | length > 0 %}
SERVICE_TOKEN_RETENTION_DAYS={{ env_value((fd_self_service_token_retention_days)) }}
{% endif %}

# Optional Monitoring
{% if sentry_dsn is defined %}
SENTRY_DSN={{ env_value((sentry_dsn)) }}
{% endif %}
{% if datadog_api_key is defined %}
DATADOG_API_KEY={{ env_value((datadog_api_key)) }}
{% endif %}

[Unit]
Description=FastDeploy {{ service_name }}
After=network.target postgresql.service

[Service]
Type=simple
User={{ fd_self_user }}
Group={{ fd_self_group }}
WorkingDirectory={{ service_dir }}
Environment="PATH={{ service_dir }}/.venv/bin:/home/{{ fd_self_user }}/.local/bin:/usr/local/bin:/usr/bin:/bin"
# DATABASE_URL and SECRET_KEY come from a root-only 0600 file that systemd
# reads as root, so secrets stay out of this world-readable unit.
EnvironmentFile=/etc/default/{{ service_name }}
Environment="PATH_FOR_DEPLOY={{ fd_self_base_dir }}"
ExecStart={{ service_dir }}/.venv/bin/python -m uvicorn \
    deploy.entrypoints.fastapi_app:app \
    --host 127.0.0.1 \
    --port {{ service_port }}

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::{{ minio_backup_account_bucket }}"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::{{ minio_backup_account_bucket }}"],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
{% for prefix in minio_backup_account_prefixes %}
            "{{ prefix }}/*"{{ "," if not loop.last }}
{% endfor %}
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"{{ ', "s3:DeleteObject"' if minio_backup_account_allow_delete | bool }}],
      "Resource": [
{% for prefix in minio_backup_account_prefixes %}
        "arn:aws:s3:::{{ minio_backup_account_bucket }}/{{ prefix }}/*"{{ "," if not loop.last }}
{% endfor %}
      ]
    }
  ]
}

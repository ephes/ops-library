<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>de.wersdoerfer.opsgate.runner</string>

    <key>ProgramArguments</key>
    <array>
      <string>/usr/bin/env</string>
      <string>bash</string>
      <string>-lc</string>
      <string>cd /Users/ops/opsgate &amp;&amp; exec /usr/local/libexec/opsgate-rs/0.3.0/opsgate runner</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
      <key>HOME</key>
      <string>/Users/ops</string>
      <key>OPSGATE_ENV_FILE</key>
      <string>/etc/opsgate/opsgate-runner.env</string>
      <key>OPSGATE_TMUX_SOCKET_LABEL</key>
      <string>remediation</string>
      <key>PATH</key>
      <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
      <key>TMUX_TMPDIR</key>
      <string>/Users/ops/remediation/tmux</string>
    </dict>

    <key>UserName</key>
    <string>ops</string>
    <key>GroupName</key>
    <string>ops</string>
    <key>WorkingDirectory</key>
    <string>/Users/ops/remediation</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/var/log/opsgate/opsgate-runner.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/opsgate/opsgate-runner.err.log</string>
  </dict>
</plist>

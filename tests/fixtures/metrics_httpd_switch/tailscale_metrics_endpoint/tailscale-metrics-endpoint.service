[Unit]
Description=Tailscale metrics HTTP endpoint
After=tailscaled.service network-online.target
Wants=tailscaled.service network-online.target

[Service]
Type=exec
User=metrics
Group=metrics
WorkingDirectory=/usr/local/bin
ExecStart=/usr/bin/python3 /usr/local/bin/tailscale_metrics_httpd.py \
  --bind 100.64.0.10 \
  --port 9107 \
  --path /.well-known/tailscale \
  --json-path /var/lib/tailscale-metrics/tailscale.json \
  --htpasswd-file /etc/tailscale-metrics-endpoint/htpasswd

Restart=always
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectHostname=true
RestrictRealtime=true
LockPersonality=true
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=100.64.0.0/10

ReadOnlyPaths=/var/lib/tailscale-metrics

[Install]
WantedBy=multi-user.target

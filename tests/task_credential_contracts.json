  {
    "file": "roles/mastodon_restore/tasks/main.yml",
    "task": "Roll back the database from the safety dump",
    "attributes": {
      "become": true,
      "become_user": "{{ mastodon_restore_postgres_become_user }}",
      "when": [
        "mastodon_restore_db_exists | bool",
        "not (mastodon_restore_rescue_running | bool)"
      ],
      "failed_when": false,
      "changed_when": true,
      "register": "mastodon_restore_db_rollback",
      "no_log": "{{ (mastodon_restore_postgres_password | default('') | length > 0) }}"
    },
    "module": "ansible.builtin.shell",
    "arguments": "set -euo pipefail\nadmin=()\ncase \"$PG_HOST\" in\n  \"\"|localhost|127.0.0.1|::1) ;;\n  *) admin+=(\"--host=$PG_HOST\") ;;\nesac\nif [ -n \"$PG_PORT\" ]; then admin+=(\"--port=$PG_PORT\"); fi\nconn=()\nif [ -n \"$PG_HOST\" ]; then conn+=(\"--host=$PG_HOST\"); fi\nif [ -n \"$PG_PORT\" ]; then conn+=(\"--port=$PG_PORT\"); fi\n\"$DROPDB\" \"${admin[@]}\" --if-exists \"$DB\"\n\"$CREATEDB\" \"${admin[@]}\" --owner=\"$DB_OWNER\" \"$DB\"\n\"$PG_RESTORE\" \"${conn[@]}\" --username=\"$DB_OWNER\" --dbname=\"$DB\" \\\n  --single-transaction --no-owner \"$SAFETY_DUMP\"\n",
    "args": {
      "executable": "/bin/bash"
    }
  },

    "arguments": {
      "argv": "{{ [mastodon_restore_postgres_psql_binary]\n   + mastodon_restore_pg_conn_args\n   + ['--dbname=' ~ mastodon_restore_postgres_database, '--no-psqlrc',\n      '--tuples-only', '--no-align', '--command=SELECT 1'] }}"

  {
    "file": "roles/archive_deploy/tasks/django.yml",
    "task": "django | Run archive migrations",
    "attributes": {
      "become": true,
      "become_user": "{{ archive_user }}"
    }
  },
  {
    "file": "roles/archive_deploy/tasks/django.yml",
    "task": "django | Collect archive static files",
    "attributes": {
      "become": true,
      "become_user": "{{ archive_user }}"
    }
  },
  {
    "file": "roles/archive_deploy/tasks/django.yml",
    "task": "django | Ensure archive admin user exists",
    "attributes": {
      "become": true,
      "become_user": "{{ archive_user }}",
      "failed_when": false,
      "changed_when": "'Created admin user' in (archive_ensure_admin_user.stdout | default('')) or ('Updated admin user' in (archive_ensure_admin_user.stdout | default(''))\n    and '(password unchanged)' not in (archive_ensure_admin_user.stdout | default('')))",
      "register": "archive_ensure_admin_user",
      "no_log": true
    }
  },
  {
    "file": "roles/nyxmon_deploy/tasks/django.yml",

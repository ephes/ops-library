    "module": "ansible.builtin.shell",
    "arguments": "set -euo pipefail\n{{ mastodon_backup_postgres_dump_binary }} \\\n  {{ mastodon_backup_pg_dump_host_flag }} \\\n  {{ mastodon_backup_pg_dump_port_flag }} \\\n  --username={{ mastodon_backup_postgres_user }} \\\n  --format={{ mastodon_backup_postgres_format }} \\\n  --compress={{ mastodon_backup_postgres_compress }} \\\n  --file \"{{ mastodon_backup_db_dump }}\" \\\n  {{ mastodon_backup_postgres_database }}\n",
    "args": {
      "executable": "/bin/bash"
    }
  },
  {
    "file": "roles/mastodon_restore/tasks/main.yml",

    "attributes": {
      "become": true,
      "become_user": "{{ nyxmon_user }}",
      "when": "not nyxmon_skip_django_manage | default(false)"
    }
  },
  {
    "file": "roles/nyxmon_deploy/tasks/django.yml",
    "task": "django | Collect static files",
    "attributes": {
      "become": true,
      "become_user": "{{ nyxmon_user }}",
      "when": "not nyxmon_skip_django_manage | default(false)"
    }
  },
  {
    "file": "roles/fastdeploy_deploy/tasks/initialize.yml",
    "task": "initialize | Create initial admin user",
    "attributes": {
      "become": "{{ fastdeploy_initialize_become | default(true) }}",
      "become_user": "{{ fastdeploy_user }}",
      "when": "fastdeploy_create_initial_user",
      "failed_when": "(create_user_result.rc != 0 or 'failed to create user' in (create_user_result.stdout | lower) or 'failed to create user' in (create_user_result.stderr | lower)) and 'duplicate key' not in ((create_user_result.stdout ~ ' ' ~ create_user_result.stderr) | lower)",
      "changed_when": "'created:' in (create_user_result.stdout | lower)",
      "register": "create_user_result",
      "no_log": true
    }
  },
  {
    "file": "roles/fastdeploy_deploy/tasks/initialize.yml",
    "task": "initialize | Sync services from filesystem",
    "attributes": {
      "become": "{{ fastdeploy_initialize_become | default(true) }}",
      "become_user": "{{ fastdeploy_user }}",
      "when": "fastdeploy_sync_services",
      "changed_when": "\"services synced\" in sync_result.stdout",
      "register": "sync_result"
    }
  },

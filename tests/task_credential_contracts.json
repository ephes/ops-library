  {
    "file": "roles/fastdeploy_restore/tasks/restore.yml",
    "task": "Restore PostgreSQL dump",
    "attributes": {
      "become": true,
      "become_user": "{{ fastdeploy_restore_postgres_become_user }}"
    },
    "module": "ansible.builtin.shell",
    "arguments": "set -euo pipefail\n{\n  printf 'SET ROLE %s;\\n' \"{{ fastdeploy_restore_postgres_user }}\"\n  cat \"{{ fastdeploy_restore_snapshot_dir }}/database/{{ fastdeploy_restore_postgres_database }}.sql\"\n} | {{ fastdeploy_restore_psql_binary }} \"{{ fastdeploy_restore_postgres_database }}\"\n",
    "args": {
      "executable": "/bin/bash"
    }
  },
  {
    "file": "roles/mastodon_backup/tasks/main.yml",
    "task": "Dump PostgreSQL database",
    "attributes": {
      "become": true,
      "become_user": "{{ mastodon_backup_postgres_become_user }}",
      "no_log": "{{ (mastodon_backup_postgres_password | default('') | length > 0) }}"

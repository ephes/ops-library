    "arguments": "set -euo pipefail\n{{ paperless_backup_postgres_dump_binary }} \\\n  {{ ('--host=' + paperless_backup_postgres_host) if paperless_backup_postgres_host else '' }} \\\n  {{ ('--port=' + (paperless_backup_postgres_port | string)) if paperless_backup_postgres_host else '' }} \\\n  --username={{ paperless_backup_postgres_user }} \\\n  {{ paperless_backup_postgres_dump_options }} \\\n  {{ paperless_backup_postgres_database }} > \"{{ paperless_backup_dir }}/database/{{ paperless_backup_postgres_database }}.sql\"\n",
    "args": {

  {
    "file": "roles/unifi_deploy/tasks/mongodb.yml",
    "task": "mongodb | Verify user was created successfully",
    "attributes": {
      "when": [
        "unifi_mongodb_enable_auth | bool",
        "unifi_mongodb_user_check.rc is defined",
        "unifi_mongodb_user_check.rc != 0",
        "not (unifi_mongodb_user_creation_failed | default(false))"
      ],
      "failed_when": "unifi_mongodb_user_verify.rc != 0",
      "changed_when": false,
      "register": "unifi_mongodb_user_verify",
      "no_log": true
    }
  },
  {
    "file": "roles/unifi_deploy/tasks/homeassistant.yml",
    "task": "homeassistant | Probe for default site",
    "attributes": {
      "failed_when": false,
      "changed_when": false,
      "register": "unifi_homeassistant_site_probe",
      "no_log": true
    }
  },
  {
    "file": "roles/unifi_deploy/tasks/homeassistant.yml",
    "task": "homeassistant | Wait for default site",
    "attributes": {
      "changed_when": false,
      "register": "unifi_homeassistant_site_check",
      "retries": "{{ unifi_homeassistant_wait_retries }}",
      "delay": "{{ unifi_homeassistant_wait_delay }}",
      "until": "unifi_homeassistant_site_check.rc == 0",
      "no_log": true
    }
  },
  {
    "file": "roles/unifi_deploy/tasks/homeassistant.yml",
    "task": "homeassistant | Read existing user password hash",
    "attributes": {
      "changed_when": false,
      "register": "unifi_homeassistant_existing_hash",
      "no_log": true
    }
  },
  {
    "file": "roles/unifi_deploy/tasks/homeassistant.yml",
    "task": "homeassistant | Hash password for MongoDB",
    "attributes": {
      "changed_when": false,
      "register": "unifi_homeassistant_password_hash",
      "no_log": true
    }
  },
  {
    "file": "roles/unifi_deploy/tasks/homeassistant.yml",
    "task": "homeassistant | Apply MongoDB script",
    "attributes": {
      "failed_when": "'STATUS=error' in unifi_homeassistant_user.stdout",
      "changed_when": "'changed=true' in unifi_homeassistant_user.stdout.lower()",
      "register": "unifi_homeassistant_user",
      "no_log": true
    }
  },
  {
    "file": "roles/unifi_remove/tasks/main.yml",
    "task": "Drop UniFi MongoDB database",
    "attributes": {
      "when": [
        "unifi_remove_drop_mongodb_database | bool",
        "unifi_mongodb_password | length > 0"
      ],
      "failed_when": false,
      "changed_when": true,
      "register": "unifi_remove_drop_db",
      "no_log": true
    }
  },
  {
    "file": "roles/unifi_remove/tasks/main.yml",
    "task": "Drop UniFi MongoDB user",
    "attributes": {
      "when": [
        "unifi_remove_drop_mongodb_user | bool",
        "unifi_mongodb_password | length > 0"
      ],
      "failed_when": false,
      "changed_when": true,
      "register": "unifi_remove_drop_user",
      "no_log": true
    }
  },
  {
    "file": "roles/minecraft_java_backup/tasks/main.yml",
    "task": "Disable auto-save",
    "attributes": {
      "when": "minecraft_server_is_running",
      "changed_when": true,
      "register": "save_off_result",
      "no_log": true
    }
  },
  {
    "file": "roles/minecraft_java_backup/tasks/main.yml",
    "task": "Flush world to disk",
    "attributes": {
      "when": "minecraft_server_is_running",
      "changed_when": true,
      "register": "save_all_result",
      "no_log": true
    }
  },
  {
    "file": "roles/minecraft_java_backup/tasks/main.yml",
    "task": "Re-enable auto-save",
    "attributes": {
      "when": "minecraft_saves_disabled | default(false)",
      "changed_when": true,
      "register": "save_on_result",
      "ignore_errors": true,
      "no_log": true
    }
  },
  {
    "file": "roles/mail_relay_deploy/tasks/sasl.yml",
    "task": "sasl | Create relay user in sasldb2",
    "attributes": {
      "when": [
        "not ansible_check_mode",
        "(sasldb_users.stdout is not defined) or (mail_relay_sasl_user ~ '@' ~ mail_relay_hostname not in sasldb_users.stdout)"
      ],
      "notify": "Restart postfix",
      "no_log": true
    }
  },
  {
    "file": "roles/mail_relay_deploy/tasks/sasl.yml",
    "task": "sasl | Update relay user password in sasldb2",
    "attributes": {
      "when": [
        "not ansible_check_mode",
        "sasldb_users.stdout is defined",
        "mail_relay_sasl_user ~ '@' ~ mail_relay_hostname in sasldb_users.stdout"
      ],
      "changed_when": false,
      "no_log": true
    }
  },
  {
    "file": "roles/redis_install/tasks/service.yml",
    "task": "Check if Redis accepts configured password",
    "attributes": {
      "when": [
        "redis_install_requirepass_enabled | bool",
        "redis_install_password | length > 0"
      ],
      "failed_when": false,
      "changed_when": false,
      "register": "redis_ping_with_auth",
      "no_log": true
    }
  },
  {
    "file": "roles/paperless_backup/tasks/main.yml",
    "task": "Run Paperless document_exporter",
    "attributes": {
      "become": true,
      "become_user": "{{ paperless_backup_user }}",
      "when": "paperless_backup_exporter_enabled",
      "no_log": "{{ paperless_backup_exporter_passphrase | length > 0 }}"
    }
  }
]

      "until": "_paperless_restore_pg_check.rc == 0"
    },
    "module": "ansible.builtin.shell",
    "arguments": "set -euo pipefail\necho \"{{ paperless_restore_postgres_test_query }}\" | {{ paperless_restore_psql_binary }} \\\n  --host={{ paperless_restore_postgres_host }} \\\n  --port={{ paperless_restore_postgres_port }} \\\n  --username={{ paperless_restore_postgres_user }} \\\n  --dbname={{ paperless_restore_postgres_database }} \\\n  --set ON_ERROR_STOP=1\n",
    "args": {
      "executable": "/bin/bash"
    }
